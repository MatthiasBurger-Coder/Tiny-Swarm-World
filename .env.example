# Tiny Swarm World operator configuration template.
#
# The ordinary internal-test install needs no credential preparation. It uses
# the deterministic catalog in
# documentation/arc42/08_configuration/internal-test-credential-catalog.md.
# Uncomment only the values you intentionally override. Process environment
# values override values from this optional local file.

# Optional credential overrides. Leave these empty to use the catalog; replace
# an individual value only when you intentionally provide an override.
TSW_PORTAINER_ADMIN_PASSWORD=""
TSW_NEXUS_ADMIN_PASSWORD=""
TSW_JENKINS_ADMIN_PASSWORD=""
TSW_SONARQUBE_ADMIN_PASSWORD=""
TSW_POSTGRES_PASSWORD=""
TSW_SONARQUBE_POSTGRES_PASSWORD=""
TSW_PULSAR_TOKEN_SECRET_KEY=""
TSW_PULSAR_ADMIN_TOKEN=""
TSW_PULSAR_MANAGER_ADMIN_PASSWORD=""
TSW_INFISICAL_LOGIN_EMAIL=""
TSW_INFISICAL_BOOTSTRAP_ADMIN_PASSWORD=""
TSW_INFISICAL_ENCRYPTION_KEY=""
TSW_INFISICAL_AUTH_SECRET=""
TSW_INFISICAL_POSTGRES_PASSWORD=""
TSW_INFISICAL_REDIS_PASSWORD=""
TSW_TRAEFIK_GUI_USERS_HTPASSWD=""

# Optional deployment controls.
TSW_PORTAINER_STACK_REQUEST_TIMEOUT_SECONDS=180
TSW_DEPLOYMENT_VERIFY_TIMEOUT_SECONDS=300
TSW_SEED_INFISICAL_ITEMS=0
TSW_LXC_DOCKER_REGISTRY_MIRROR="http://registry-cache.example.invalid:5001"
TSW_PULSAR_ADMIN_URL="http://pulsar.example.invalid:8080"
TSW_PULSAR_PUBLIC_ADMIN_URL="http://pulsar-admin.example.invalid:8087"

# Optional Traefik Docker secret names.
TSW_TRAEFIK_TLS_CERT_SECRET_NAME="tsw_traefik_tls_cert"
TSW_TRAEFIK_TLS_KEY_SECRET_NAME="tsw_traefik_tls_key"
TSW_TRAEFIK_GUI_USERS_SECRET_NAME="tsw_traefik_gui_users"
